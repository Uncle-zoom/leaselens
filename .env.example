# Copy to .env (in this folder or the folder above it) and fill in your own key.
PORTKEY_API_KEY=your-portkey-key-here
MODEL=gpt-6-luna
# Optional, not used by default:
OPENAI_API_KEY=

# Contact e-mail sent in the User-Agent of public-data requests. Optional but polite: Nominatim asks to be able to reach whoever runs the app.
LEASELENS_CONTACT_EMAIL=you@example.com
# Set to 1 to run everything from data/samples/ with no network.
LEASELENS_OFFLINE=0
